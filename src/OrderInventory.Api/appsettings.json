{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=OrderInventory;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "OrderInventory",
    "Audience": "OrderInventory",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "OrderMaintenance": {
    "PendingTimeoutMinutes": 30,
    "ScanIntervalSeconds": 30
  },
  "Seed": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
